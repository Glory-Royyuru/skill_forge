# Copy to .env and fill in as needed. Every value here has a working
# default — the whole test suite and `make run` work with none of this set,
# since agents default to "mock" provider/model.

DATABASE_URL=sqlite:///./skillforge.db

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

TEACHER_PROVIDER=mock
TEACHER_MODEL=mock-teacher
LEARNER_PROVIDER=mock
LEARNER_MODEL=mock-learner

SESSION_TOKEN_BUDGET=200000
SESSION_COST_BUDGET_USD=5.0

LLM_CACHE_ENABLED=true
