# Copy to .env and fill in as needed. Every value here has a working
# default — the whole test suite and `make run` work with none of this set,
# since agents default to "mock" provider/model.

DATABASE_URL=sqlite:///./skillforge.db

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

TEACHER_PROVIDER=mock
TEACHER_MODEL=mock-teacher
LEARNER_PROVIDER=mock
LEARNER_MODEL=mock-learner

SESSION_TOKEN_BUDGET=200000
SESSION_COST_BUDGET_USD=5.0

LLM_CACHE_ENABLED=true

# --- Teacher Agent -------------------------------------------------------------
# Offline learner model for the Teacher Agent: "bkt" (Bayesian Knowledge
# Tracing, pure Python, configured parameters) or "none" to run on the
# deterministic rules alone.
TEACHER_LEARNER_MODEL=bkt

# --- Web application -----------------------------------------------------------
# "development" or "production". Development enables the local email outbox below.
APP_ENV=development
# Where the frontend is served; used to build links in emails.
FRONTEND_BASE_URL=http://localhost:5173
# Browser origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Student accounts ----------------------------------------------------------
SESSION_COOKIE_NAME=sf_session
SESSION_TTL_HOURS=168
# Must be true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
VERIFICATION_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60

# --- Email ---------------------------------------------------------------------
# console: nothing is sent; verification/reset emails (with their links) are
#          written to the backend log, and in development also exposed to
#          localhost at GET /api/dev/outbox?email=... (DEV_EMAIL_OUTBOX).
# smtp:    deliver through the SMTP server below.
EMAIL_BACKEND=console
DEV_EMAIL_OUTBOX=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SkillForge <no-reply@example.com>
# Use STARTTLS on SMTP_PORT (587), or implicit TLS with SMTP_SSL=true (port 465).
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
